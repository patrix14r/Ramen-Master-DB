# Copia este archivo como ".env" y rellena tus valores reales.
# ".env" NO se sube a Git (está en .gitignore); ".env.example" SÍ, como plantilla.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=ramen_master_db

# Clave para firmar los tokens de sesion (JWT). Genera una larga y aleatoria:
#   openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_IN=30d
