---
// ============================================================
// carrito.astro — Carrito y checkout (con Header y Footer del layout)
// ============================================================
import MainLayout from '../layouts/MainLayout.astro';
import CheckoutManager from '../components/CheckoutManager.jsx';
---

<MainLayout titulo="Carrito" descripcion="Revisa tu pedido y confirma la entrega y el pago.">
  <section class="contenedor py-10">
    <h1 class="mb-6 text-3xl font-bold tracking-tight text-bone">Carrito</h1>
    <CheckoutManager client:load />
  </section>
</MainLayout>
