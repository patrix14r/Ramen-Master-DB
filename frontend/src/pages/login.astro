---
// Inicio de sesión y registro con JWT.
import MainLayout from '../layouts/MainLayout.astro';
import AuthForms from '../components/AuthForms.jsx';
import { imgUrl } from '../lib/config';
---

<MainLayout titulo="Ingresar" descripcion="Inicia sesión o crea tu cuenta de Ramen Master.">
  <section class="relative isolate overflow-hidden">
    <!-- Fondo ambiental oscuro detrás del formulario -->
    <div class="absolute inset-0 -z-20 scale-105 bg-cover bg-center blur-sm" style={`background-image:url('${imgUrl('imagenes/fondos/fondo_carrito.jpg')}')`}></div>
    <div class="absolute inset-0 -z-10 bg-black/80"></div>
    <div class="contenedor py-8 sm:py-12">
      <AuthForms client:load />
    </div>
  </section>
</MainLayout>
