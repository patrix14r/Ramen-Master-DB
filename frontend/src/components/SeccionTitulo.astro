---
// Encabezado reutilizable de sección (título, subtítulo y enlace opcional).
const { titulo, subtitulo, enlace, enlaceTexto } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <h2 class="text-2xl font-bold tracking-tight text-bone md:text-3xl">{titulo}</h2>
    {subtitulo && <p class="mt-1 text-sm font-light">{subtitulo}</p>}
  </div>
  {enlace && <a href={enlace} class="btn-ghost hidden shrink-0 sm:inline-flex">{enlaceTexto}</a>}
</div>
