---
// Pie de página estático (los iconos de lucide-react sin "client:" salen como SVG puro).
import { MapPin, Phone } from 'lucide-react';
import { imgUrl } from '../lib/config';

// Sedes de la tabla Sedes.
const sedes = [
  { nombre: 'Sede Santa Anita', direccion: 'Av. Cascanueces 2221, Santa Anita', telefono: '+51 942 888 275' },
  { nombre: 'Sede Miraflores', direccion: 'Av. Larco 123, Miraflores', telefono: '+51 999 888 777' },
];
const anio = new Date().getFullYear();
---

<footer class="mt-14 border-t border-white/10">
  <div class="contenedor grid gap-8 py-10 md:grid-cols-12">
    <!-- Marca -->
    <div class="md:col-span-4">
      <a href="/" class="flex items-center gap-3">
        <img src={imgUrl('imagenes/logo/logo.png')} alt="" class="h-9 w-9 rounded-full object-cover" />
        <span class="text-lg font-bold tracking-tight text-bone">Ramen Master</span>
      </a>
      <p class="mt-3 max-w-xs text-sm font-light leading-relaxed">
        Cocina nikkei: la tradición japonesa con sabores peruanos, preparada al momento.
      </p>
    </div>

    <!-- Navegación -->
    <div class="md:col-span-3">
      <h2 class="text-xs font-medium uppercase tracking-wider text-white/50">Navegación</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="transition hover:text-white">Inicio</a></li>
        <li><a href="/productos" class="transition hover:text-white">Carta completa</a></li>
        <li><a href="/carrito" class="transition hover:text-white">Carrito</a></li>
        <li><a href="/contactanos" class="transition hover:text-white">Contáctanos</a></li>
        <li><a href="/perfil" class="transition hover:text-white">Mi cuenta</a></li>
      </ul>
    </div>

    <!-- Sedes -->
    <div id="sedes" class="scroll-mt-24 md:col-span-5">
      <h2 class="text-xs font-medium uppercase tracking-wider text-white/50">Nuestras sedes</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {
          sedes.map((s) => (
            <li class="text-sm">
              <p class="font-medium text-bone">{s.nombre}</p>
              <p class="mt-1 flex items-start gap-2 font-light">
                <MapPin size={15} strokeWidth={1.5} className="mt-0.5 shrink-0" />
                {s.direccion}
              </p>
              <p class="mt-1 flex items-center gap-2 font-light">
                <Phone size={15} strokeWidth={1.5} className="shrink-0" />
                {s.telefono}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="contenedor py-4 text-xs font-light text-white/40">
      &copy; {anio} Ramen Master. Todos los derechos reservados.
    </p>
  </div>
</footer>
